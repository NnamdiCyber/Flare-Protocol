# ─────────────────────────────────────────────────────────────────────────────
# Flare Protocol — NestJS Oracle Backend Environment Variables
# Copy this file to backend/.env and fill in the values.
# Never commit the filled .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar ───────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Contract addresses (populate after running deploy-testnet.sh) ─────────────
REGISTRY_CONTRACT_ID=
CAMPAIGN_MANAGER_CONTRACT_ID=
REWARD_VAULT_CONTRACT_ID=

# ── Oracle keypair ────────────────────────────────────────────────────────────
# Generate with: chmod +x scripts/generate-oracle-keypair.sh && ./scripts/generate-oracle-keypair.sh
# Store ORACLE_PRIVATE_KEY in HSM or AWS KMS for production — never commit it.
ORACLE_PUBLIC_KEY=
ORACLE_PRIVATE_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flare

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection string. Matches docker-compose.yml defaults.
REDIS_URL=redis://localhost:6379

# ── Twitter / X API v2 ───────────────────────────────────────────────────────
# Required for Social Sharing module verification.
# Create a project at https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET=
