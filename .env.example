# ─────────────────────────────────────────────────────────────────────────────
# Flare Protocol — Root Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit the filled .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar Network ───────────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Deployer account ──────────────────────────────────────────────────────────
# Stellar secret key used by deploy scripts to pay for contract deployment fees.
# Fund via Friendbot for testnet: https://friendbot.stellar.org
DEPLOYER_SECRET_KEY=

# ── Contract addresses (populated by deploy-testnet.sh) ──────────────────────
REGISTRY_CONTRACT_ID=
CAMPAIGN_MANAGER_CONTRACT_ID=
REWARD_VAULT_CONTRACT_ID=
